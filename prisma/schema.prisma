generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  leads        Lead[]
}

model Column {
  id        String   @id @default(uuid())
  title     String
  order     Int
  source    String   @default("kanban")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id              String    @id @default(uuid())
  title           String
  description     String?
  dueDate         DateTime?
  isPriorityToday Boolean   @default(false)
  isDoing         Boolean   @default(false)
  isWaiting       Boolean   @default(false)
  columnId        String
  column          Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  order           Int
  source          String    @default("kanban")
  assignee        String?
  logoUrl         String?
  notes           String?
  meetingsCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  completedBy     String?
  tags            TaskTag[]
}

model Tag {
  id    String    @id @default(uuid())
  name  String
  color String
  tasks TaskTag[]
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model DashboardMetric {
  id                  String   @id @default(uuid())
  date                DateTime @default(now())
  leadsTrafego        Int      @default(0)
  leadsIndicacao      Int      @default(0)
  reunioesAgendadas   Int      @default(0)
  reunioesRealizadas  Int      @default(0)
  vendasQtd           Int      @default(0)
  faturamento         Float    @default(0)
  investimentoTrafego Float    @default(0)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DashboardGoal {
  id                  String   @id @default(uuid())
  leads               Int      @default(1000)
  reunioesAgendadas   Int      @default(200)
  reunioesRealizadas  Int      @default(150)
  faturamento         Float    @default(50000)

  updatedAt           DateTime @updatedAt
}

model SdrDailyLog {
  id            String   @id @default(cuid())
  date          DateTime @unique
  leadsWhatsapp Int      @default(0)
  agendadas     Int      @default(0)
  realizadas    Int      @default(0)
  faltaLead     Int      @default(0)
  naoRealizada  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lead {
  id           String     @id @default(cuid())
  name         String?
  phone        String     @unique
  stageId      String
  stage        LeadStage  @relation(fields: [stageId], references: [id])
  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id])
  value        Float?
  temperature  String?
  messages     Message[]
  tags         LeadTag[]
  events       AgendaEvent[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LeadStage {
  id    String @id @default(cuid())
  name  String
  order Int
  color String @default("#3b82f6")
  leads Lead[]
}

model Message {
  id                String           @id @default(cuid())
  leadId            String
  lead              Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  whatsappMessageId String           @unique
  direction         MessageDirection
  content           String
  status            MessageStatus?
  createdAt         DateTime         @default(now())
}

model CrmTag {
  id    String    @id @default(cuid())
  name  String
  color String
  leads LeadTag[]
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    CrmTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model WhatsappConnection {
  id        String   @id @default(cuid())
  status    String   @default("close")
  updatedAt DateTime @updatedAt
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model EventCategory {
  id     String        @id @default(cuid())
  name   String
  color  String         @default("#3b82f6")
  events AgendaEvent[]
}

enum AgendaEventStatus {
  AGENDADA
  REALIZADA
  NAO_REALIZADA
  CANCELADA
}

model AgendaEvent {
  id          String            @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  categoryId  String?
  category    EventCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status      AgendaEventStatus @default(AGENDADA)
  seriesId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startsAt, endsAt])
  @@index([seriesId])
}
