generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  leads        Lead[]
  negotiations Negotiation[]
}

model Column {
  id        String   @id @default(uuid())
  title     String
  color     String?
  order     Int
  source    String   @default("kanban")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id              String       @id @default(uuid())
  title           String
  description     String?
  dueDate         DateTime?
  isPriorityToday Boolean      @default(false)
  isDoing         Boolean      @default(false)
  isWaiting       Boolean      @default(false)
  columnId        String
  column          Column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  order           Int
  source          String       @default("kanban")
  assignee        String?
  logoUrl         String?
  notes           String?
  meetingsCount   Int          @default(0)
  adsAtivo        Boolean      @default(false)
  promocaoAtiva   Boolean      @default(false)
  promocaoAte     DateTime?
  createdAt       DateTime     @default(now())
  completedAt     DateTime?
  completedBy     String?
  churnedAt       DateTime?
  churnReason     String?
  churnedBy       String?
  tags            TaskTag[]
  leadId          String?
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  kanbanTaskId    String?
  negotiation     Negotiation?

  @@index([source, churnedAt])
  @@index([source, createdAt])
}

model Tag {
  id    String    @id @default(uuid())
  name  String
  color String
  tasks TaskTag[]
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model DashboardMetric {
  id                  String   @id @default(uuid())
  date                DateTime @default(now())
  leadsTrafego        Int      @default(0)
  leadsIndicacao      Int      @default(0)
  reunioesAgendadas   Int      @default(0)
  reunioesRealizadas  Int      @default(0)
  vendasQtd           Int      @default(0)
  faturamento         Float    @default(0)
  investimentoTrafego Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DashboardGoal {
  id                 String @id @default(uuid())
  leads              Int    @default(1000)
  reunioesAgendadas  Int    @default(200)
  reunioesRealizadas Int    @default(150)
  faturamento        Float  @default(50000)

  updatedAt DateTime @updatedAt
}

model SdrDailyLog {
  id            String   @id @default(cuid())
  date          DateTime @unique
  leadsWhatsapp Int      @default(0)
  agendadas     Int      @default(0)
  realizadas    Int      @default(0)
  faltaLead     Int      @default(0)
  naoRealizada  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lead {
  id                 String             @id @default(cuid())
  name               String?
  phone              String             @unique
  waLid              String?            @unique
  stageId            String?
  stage              LeadStage?         @relation(fields: [stageId], references: [id])
  assignedToId       String?
  assignedTo         User?              @relation(fields: [assignedToId], references: [id])
  value              Float?
  temperature        String?
  notes              String?
  cpf                String?
  email              String?
  city               String?
  state              String?
  neighborhood       String?
  postalCode         String?
  address            String?
  instagram          String?
  nickname           String?
  mercadoLivreStatus String?
  businessArea       String?
  companyName        String?
  mlKnowledge        String?
  stock              String?
  revenue            String?
  employees          String?
  partners           String?
  profilePicUrl      String?
  followUpColumn     Int?
  followUpMovedAt    DateTime?
  closedAt           DateTime?
  lastReadAt         DateTime?
  stageEnteredAt     DateTime?
  messages           Message[]
  tags               LeadTag[]
  events             AgendaEvent[]
  campaignLeads      BulkCampaignLead[]
  followUpLogs       FollowUpLog[]
  tasks              Task[]
  negotiations       Negotiation[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([closedAt])
  @@index([createdAt])
  @@index([stageEnteredAt])
}

model FollowUpLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  column    Int? // null = removido do follow up
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model LeadStage {
  id       String  @id @default(cuid())
  name     String
  order    Int
  color    String  @default("#3b82f6")
  isEntry  Boolean @default(false)
  isClosed Boolean @default(false)
  leads    Lead[]
}

model Message {
  id                String           @id @default(cuid())
  leadId            String
  lead              Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  whatsappMessageId String           @unique
  direction         MessageDirection
  content           String
  status            MessageStatus?
  createdAt         DateTime         @default(now())
}

model CrmTag {
  id           String           @id @default(cuid())
  name         String
  color        String
  waLabelId    String?          @unique
  leads        LeadTag[]
  negotiations NegotiationTag[]
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    CrmTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model Negotiation {
  id              String           @id @default(cuid())
  leadId          String
  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  taskId          String           @unique
  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  responsibleId   String?
  responsible     User?            @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  negotiatedAt    DateTime
  expectedCloseAt DateTime?
  service         String
  quantity        Int              @default(1)
  unitPrice       Float
  discount        Float            @default(0)
  totalValue      Float
  notes           String?
  tags            NegotiationTag[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([leadId, negotiatedAt])
  @@index([responsibleId])
}

model NegotiationTag {
  negotiationId String
  tagId         String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  tag           CrmTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([negotiationId, tagId])
}

model WhatsappConnection {
  id        String   @id @default(cuid())
  status    String   @default("close")
  updatedAt DateTime @updatedAt
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model EventCategory {
  id     String        @id @default(cuid())
  name   String
  color  String        @default("#3b82f6")
  events AgendaEvent[]
}

enum AgendaEventStatus {
  AGENDADA
  REALIZADA
  FALTA
  NAO_REALIZADA
  CANCELADA
}

model AgendaEvent {
  id          String            @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  categoryId  String?
  category    EventCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status      AgendaEventStatus @default(AGENDADA)
  seriesId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startsAt, endsAt])
  @@index([seriesId])
}

// ——— Campanhas de disparo em massa ———

enum BulkCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  DONE
  CANCELLED
}

enum BulkLeadStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model BulkCampaign {
  id           String             @id @default(cuid())
  title        String
  message      String?
  mediaBase64  String?
  mediaType    String?
  mimeType     String?
  fileName     String?
  mediaCaption String?
  status       BulkCampaignStatus @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  totalLeads   Int                @default(0)
  sentCount    Int                @default(0)
  failedCount  Int                @default(0)
  delaySeconds Int                @default(7)
  leads        BulkCampaignLead[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, scheduledAt])
}

model BulkCampaignLead {
  id         String         @id @default(cuid())
  campaign   BulkCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String
  status     BulkLeadStatus @default(PENDING)
  sentAt     DateTime?
  error      String?

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
}
